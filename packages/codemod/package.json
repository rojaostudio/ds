{
  "name": "@rojaostudio/ds-codemod",
  "private": true,
  "version": "0.1.0-next.1",
  "description": "Codemod do Rojão DS — `npx @rojaostudio/ds-codemod <pasta>` migra um projeto do @rojaostudio/ds 0.x/1.x para a 2.0 (dry-run por padrão, --apply escreve).",
  "license": "MIT",
  "author": "Rojão Studio (https://rojao.studio)",
  "homepage": "https://ds.rojao.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rojaostudio/ds.git",
    "directory": "packages/codemod"
  },
  "bugs": {
    "url": "https://github.com/rojaostudio/ds/issues"
  },
  "keywords": [
    "design-system",
    "codemod",
    "migration",
    "ts-morph",
    "react"
  ],
  "type": "module",
  "bin": {
    "rojao-ds-codemod": "./dist/cli.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "tsup",
    "prepublishOnly": "node ../../scripts/guard-publisher.mjs",
    "migrate": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@rojao/config": "workspace:*",
    "@types/node": "^20.19.43",
    "eslint": "^9.18.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  }
}
